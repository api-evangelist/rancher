          "name": "List apps",
          "id": "239a6b93-cfd1-40fe-b8a8-3f3872ca61b1",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/apps",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apps"
              ]
            }
          },
